# HomeLab Configuration
DOMAIN={{ homelab_domain }}
CERT_EMAIL=admin@{{ homelab_domain }}
TZ={{ timezone }}

# Backup
BACKUP_DIR=/opt/homelab/backups
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
BACKUP_ENCRYPT_PASSWORD={{ backup_encrypt_password | default('changeme') }}

# VPN
WIREGUARD_PORT=51820
WIREGUARD_NETWORK=10.0.0.0/24

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ grafana_password | default('admin') }}

# AdGuard
ADGUARD_PORT=53
ADGUARD_UI_PORT=8080
